<Window x:Class="BleTerminal.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About BLE Serial Terminal" SizeToContent="Height" Width="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="24">
        <TextBlock Text="BLE Serial Terminal" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock x:Name="txtVersion" Foreground="{DynamicResource SubtleFg}" Margin="0,2,0,16"/>

        <TextBlock Text="About" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock x:Name="txtAbout" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
            <Button Content="GitHub" Padding="16,6" Margin="0,0,10,0" Click="GitHub_Click"/>
            <Button Content="&#x2665;  Donate - Buy me a coffee" Padding="16,6" Click="Donate_Click"/>
        </StackPanel>

        <TextBlock Text="Donations are voluntary and are not required to use the software."
                   TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12" Foreground="{DynamicResource SubtleFg}"/>

        <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" IsDefault="True" Width="80" Padding="0,4"/>
            <TextBlock x:Name="txtLicense" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SubtleFg}"/>
        </DockPanel>
    </StackPanel>
</Window>
